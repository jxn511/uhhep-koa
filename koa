        "$tarball" "$KOA_USER@$KOA_DTN:$dest/" || die "transfer failed"
    # Verify the FAR END, not the transfer's own exit code: a truncated file
    # can still exit 0. Verify via the DTN -- the same node the bytes landed
    # on, one filesystem with the login host -- so push needs only ONE live
    # socket. Verifying via the login host would need both, and a shipment
    # once stalled on exactly that when the login socket died under a DNS
    # switchover while the DTN socket survived.
    far=$(kssh "$KOA_DTN" "sha256sum $dest/$(basename "$tarball") 2>/dev/null | awk '{print \$1}'")
    if [ "$sum" = "$far" ]; then
        echo "koa: VERIFIED $dest/$(basename "$tarball")"
        rm -f "$tarball"
    else
        die "sha256 MISMATCH -- local $sum, remote ${far:-<none>}; tarball kept at $tarball"
    fi
    ;;

stage)
    # What is already up there. Run this BEFORE re-uploading anything.
    need_socket
    kssh "$KOA_HOST" "ls -lh $STAGE_DIR 2>/dev/null || echo 'stage dir not present: $STAGE_DIR'"
    kssh "$KOA_HOST" "df -h $KOA_SCRATCH 2>/dev/null | tail -1"
    ;;

restore-test)
    # A copy nobody has restored from is a hypothesis. Pull one file back out
    # of a tarball `koa push` shipped and diff it against the local original --
    # cheap, and it exercises the whole path (permissions, tar integrity,
    # transfer) rather than trusting that a successful upload implies a
    # successful download.
    need_socket
    src="${1:-}"
    [ -n "$src" ] && [ -f "$src" ] || die "usage: koa restore-test <local file> [remote tarball]
  the file must be one that lives inside a directory you pushed"
    # `push <dir>` stores members as <basename dir>/..., so by default look for
    # the tarball named after this file's own parent directory.
    parent=$(basename "$(dirname "$(readlink -f "$src")")")
    tarball="${2:-$STAGE_DIR/$parent.tar.gz}"
    member="$parent/$(basename "$src")"
    echo "koa: restore-test $member  <-  $tarball"
    tmp=$(mktemp -d)
    # Extract JUST the one member, remotely, then bring it back.
    if ! kssh "$KOA_HOST" "tar xzf $tarball -O '$member' 2>/dev/null" > "$tmp/restored" 2>/dev/null \
       || [ ! -s "$tmp/restored" ]; then
        rm -rf "$tmp"
        die "could not extract '$member' from $tarball -- run: koa push $(dirname "$src")"
    fi
    if cmp -s "$src" "$tmp/restored"; then
        echo "koa: RESTORE VERIFIED -- $(wc -c < "$tmp/restored") bytes, byte-identical"
        rm -rf "$tmp"
    else
        echo "koa: RESTORE MISMATCH -- local and restored differ" >&2
        echo "  local    : $(sha256sum "$src" | cut -c1-16)" >&2
        echo "  restored : $(sha256sum "$tmp/restored" | cut -c1-16)" >&2
        echo "  kept at  : $tmp/restored" >&2
        exit 1
    fi
    ;;

verify)
    need_socket
    g=$(kssh "$KOA_HOST" 'hostname; echo "jobid=[$SLURM_JOB_ID]"' 2>/dev/null | tr '\n' ' ')
    echo "gateway : $g"
    id="$(current_jobid)" || exit 2
    c=$(kssh "$KOA_HOST" "srun --jobid=$id --overlap bash -lc 'hostname; echo jobid=[\$SLURM_JOB_ID]'" 2>/dev/null | tr '\n' ' ')
    echo "compute : $c"
    # The check that matters: two DIFFERENT hostnames. Identical ones mean the
    # step silently ran on the login node, which looks like success until the
    # job is killed for CPU abuse.
    gh=${g%% *}; ch=${c%% *}
    if [ -n "$ch" ] && [ "$gh" != "$ch" ]; then
        echo "koa: BRIDGE OK -- steps reach a compute node"
    else
        echo "koa: BRIDGE SUSPECT -- gateway and 'compute' are the same host" >&2
        exit 1
    fi
    ;;

*)
    # The usage text IS the header comment, printed out of the file itself.
    # The range used to end at a hardcoded line number, and each time a
    # subcommand was added the usage silently stopped listing it -- a help
    # text that lies by omission. Anchor on the marker instead, so the next
    # addition cannot reintroduce this.
    end=$(grep -n '^# Exit codes follow' "${BASH_SOURCE[0]}" | cut -d: -f1)
    sed -n "3,$((end - 2))p" "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
    exit 1
    ;;
esac
