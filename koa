        m = fwn[k] + 0; for (q = 1; q <= m; q++) tmpw[q] = fw[k, q]; md = median(tmpw, m)
        printf "%-24s %5d %10.1f %9.1f %4.0f%% %-8s %8s %6.1fG %8s %7d\n", substr(k, 1, 24), fn[k], fa[k]/3600, fu[k]/3600, e, cc, fr[k], fp[k], (md < 0 ? "n/a" : sprintf("%.0fm", md)), fpre[k] + 0 }
