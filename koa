#!/usr/bin/env bash
#
# koa -- drive Koa (UH Manoa HPC, Slurm) from your laptop, one command at a time.
#
# WHY THIS EXISTS. Koa authentication is interactive (publickey AND Duo), and a
# script -- or an assistant -- driving it runs ONE command per invocation with
# no terminal to answer a Duo prompt. SSH connection multiplexing resolves
# that: `koa up` authenticates ONCE and leaves a control socket; every later
# subcommand rides it non-interactively. Without the socket each call would
# hang on a prompt nobody can answer.
#
# WHAT IT DELIBERATELY DOES NOT DO. It never handles a password, never writes a
# credential, and never runs compute on the login node. `step` and `batch` are
# the only ways it reaches an actual compute resource, and both refuse to
# silently fall back to the gateway -- a job that quietly runs on the login
# node looks identical to a working one until it is killed for CPU abuse.
#
#   koa up                    authenticate once (interactive; you answer Duo)
#   koa status                is the socket alive, and what is queued
#   koa q [user]              the queue with CORES and MEMORY per job; the user
#                             is the session's own unless one is named
#   koa job [user] <jobid>    one job in full (scontrol + sstat + sacct), the
#                             Slurm counterpart of LSF's bjobs -l
#   koa down                  close the sockets
#
#   koa run  <cmd...>         run on the GATEWAY (git, squeue, ls -- cheap only)
#   koa step <cmd...>         run inside YOUR CURRENT ALLOCATION (real Koa)
#   koa batch <sbatch-args>   submit a job
#   koa queues                partition occupancy, and the scheduler's own
#                             start estimates for your pending jobs
#   koa watch <jobid>         poll until the job leaves the queue
#   koa tail  <jobid>         show the job's output file (~/logs)
#   koa kill  <jobid>[,..] [--name <JobName>] [--state <STATE>] [--signal <SIG>] [--apply]
#                             cancel YOUR jobs: lists the matches and stops (a dry
#                             run) unless --apply; a whole array by its base id,
#                             one task as <id>_<task>; never another user's job
#   koa jobstats [user] [--since 7d|<YYYY-MM-DD>] [--name <JobName>] [--family] [--no-running]
#   koa cost <jobid>[,<jobid>...] [--name <JobName>] [--since 7d|<YYYY-MM-DD>] [--resumable]
#                             human-readable job statistics, past and current: per job
#                             the cores, elapsed, CPU efficiency (CPU time used over
#                             elapsed x cores), memory requested vs peak; --family folds
#                             them per job-name family, with the median submit-to-start
#                             wait and the preempted / requeued count; running jobs live
#   koa route <cpus> <mem> [<run minutes>] [--resumable [<cell minutes>]]
#                             where to submit a job of this shape NOW: the scheduler's own
#                             start estimate on belle2, shared and kill-shared (sbatch
#                             --test-only), the measured kill-queue preemption rate, and
#                             the expected completion time per route under the rule
#                             "kill-shared only when the non-kill wait exceeds its wait
#                             plus the expected preemption loss"
#
#   koa push <path> [dest]    tar + ship + VERIFY sha256 (Lustre-friendly)
#   koa stage                 what is already staged on Koa, and free space
#   koa restore-test <file> [tarball]
#                             pull one file back out of a pushed tarball and
#                             diff it -- prove recovery, do not assume it
#   koa verify                prove the bridge reaches a COMPUTE node
#
# Configuration: the block at the top of this script, ~/.config/koa/config,
# and koa.conf.example in the repository.
# A recipe for transferring data from KEK to Koa lives in the README.
#
# Exit codes follow the project convention: 0 ok, 1 degraded/refused, 2 cannot
# run (no socket, no allocation).
set -uo pipefail

# --- configuration ---------------------------------------------------------
# Every value below is overridable in two ways: by an environment variable of
# the same name, and by an optional config file ~/.config/koa/config -- a
# plain KEY=value file (shell syntax, sourced if it exists; set KOA_CONFIG to
# point somewhere else).
#
# Precedence is environment > config file > default. The environment values are
# captured BEFORE the file is sourced, because sourcing would otherwise clobber
# an explicit `KOA_PART_GPU=gpu-sandbox koa batch ...` on the command line.
_env_KOA_USER="${KOA_USER-}"
_env_KOA_HOST="${KOA_HOST-}"
_env_KOA_DTN="${KOA_DTN-}"
_env_KOA_PART_CPU="${KOA_PART_CPU-}"
_env_KOA_PART_GPU="${KOA_PART_GPU-}"
_env_KOA_SCRATCH="${KOA_SCRATCH-}"

KOA_CONFIG="${KOA_CONFIG:-$HOME/.config/koa/config}"
# shellcheck source=/dev/null
[ -r "$KOA_CONFIG" ] && . "$KOA_CONFIG"

# $USER itself can be unset in a non-login environment (cron, a container), and
# `set -u` would abort on it, so id(1) is the last resort.
KOA_USER="${_env_KOA_USER:-${KOA_USER:-${USER:-$(id -un)}}}"
# KOA_HOST may be a real hostname or an ssh config alias. The author's own
# ~/.ssh/config defined `Host koa` for koa.its.hawaii.edu (and `koa-dtn` for
# the data transfer node); either form works here, because every ssh
# invocation passes the user explicitly as $KOA_USER@$KOA_HOST.
KOA_HOST="${_env_KOA_HOST:-${KOA_HOST:-koa.its.hawaii.edu}}"
KOA_DTN="${_env_KOA_DTN:-${KOA_DTN:-koa-dtn.its.hawaii.edu}}"
# MEASURED on the cluster, correcting the guesses this block used to carry:
#   partitions          shared (3d, default) / shared-long (7d) / sandbox (4h)
#                       gpu (3d) / gpu-sandbox (4h) / kill-* (preemptible)
#                       There is NO 'koa' or 'koa-gpu' partition.
#   scratch             ~/koa_scratch is normally a symlink to
#                       /mnt/lustre/koa/scratch/$USER
#   group store         /mnt/lustre/koa/lab/<your_group>
#   modules             a FULL tree exists (lang/Python, CUDA, NVHPC,
#                       tools/Singularity/latest); load what you need inside
#                       the job, not on the login node.
#   noexec              /home AND /mnt/lustre are mounted noexec ON THE LOGIN
#                       NODE: nothing user-installed executes there. Whether
#                       compute nodes relax this decides venv-on-scratch vs
#                       Singularity; test it in your first allocation.
KOA_PART_CPU="${_env_KOA_PART_CPU:-${KOA_PART_CPU:-shared}}"
KOA_PART_GPU="${_env_KOA_PART_GPU:-${KOA_PART_GPU:-gpu}}"
KOA_SCRATCH="${_env_KOA_SCRATCH:-${KOA_SCRATCH:-/mnt/lustre/koa/scratch/$KOA_USER}}"
unset _env_KOA_USER _env_KOA_HOST _env_KOA_DTN \
      _env_KOA_PART_CPU _env_KOA_PART_GPU _env_KOA_SCRATCH

# Derived, not configured: where `push` lands by default, and what `stage`
# reports on.
STAGE_DIR="$KOA_SCRATCH/incoming"
# Must outlast a working session; `koa up` is the one interactive moment.
CONTROL_PERSIST=8h

die()  { echo "koa: $*" >&2; exit 2; }
# A user name is a POSIX account name (letters, digits, . _ -); anything else is
# refused before it can reach the remote shell.
valid_user() { case "$1" in ''|*[!A-Za-z0-9._-]*) die "not a user name: '$1'";; esac; }
warn() { echo "koa: $*" >&2; }

# Where the control socket for a host lives. Honour an ssh config that already
# sets ControlPath (the author's did: ~/.ssh/cm-koa, ~/.ssh/cm-koa-dtn), and
# otherwise use that same scheme under ~/.ssh/, named from the host so the two
# sockets never collide.
ctl_path() {
    local host="$1" sock
    sock=$(ssh -G "$KOA_USER@$host" 2>/dev/null | awk '/^controlpath /{print $2; exit}')
    sock="${sock/#\~/$HOME}"
    if [ -z "$sock" ] || [ "$sock" = "none" ]; then
        sock="$HOME/.ssh/cm-${host//[^A-Za-z0-9._-]/_}"
    fi
    printf '%s\n' "$sock"
}

# Every remote call goes through these two, so the socket path and the explicit
# user are stated in exactly one place.
kssh() {
    local host="$1"; shift
    ssh -o ControlPath="$(ctl_path "$host")" "$KOA_USER@$host" "$@"
}
kctl() {   # kctl <host> <check|exit>
    ssh -o ControlPath="$(ctl_path "$1")" -O "$2" "$KOA_USER@$1" >/dev/null 2>&1
}

# The socket is the whole mechanism, so every subcommand that needs it says so
# rather than hanging on a password prompt that cannot be answered.
need_socket() {
    # Takes the host to test (default: the login host). The two sockets live
    # and die independently -- the login one died under a Windows DNS
    # switchover once while the DTN one survived -- so a subcommand must gate
    # on the socket it actually uses, not on the login socket as a proxy for
    # "authenticated".
    local host="${1:-$KOA_HOST}" sock
    sock=$(ctl_path "$host")
    # A ControlPath carrying % tokens is expanded by ssh, not by us, so it
    # cannot be stat'ed from here; `ssh -O check` is the authority either way.
    case "$sock" in
        *%*) : ;;
        *) [ -S "$sock" ] || die "no control socket for $host. Run:  koa up" ;;
    esac
    kctl "$host" check || die "socket for $host is stale. Run:  koa up"
}

# Find the caller's running allocation. Refuses on ambiguity rather than
# guessing which job to run inside -- dispatching a step into the wrong
# allocation is worse than stopping.
current_jobid() {
    local ids n
    ids=$(kssh "$KOA_HOST" 'squeue -u $USER -h -t RUNNING -o %i' 2>/dev/null | tr -d '\r')
    n=$(printf '%s\n' "$ids" | grep -c '[0-9]')
    [ "$n" -eq 0 ] && die "no RUNNING allocation. Start one in your terminal:
    salloc -p $KOA_PART_GPU --gres=gpu:1 -c 8 --mem=64G -t 4:00:00"
    [ "$n" -gt 1 ] && die "several running jobs -- pass one explicitly:
$(printf '%s\n' "$ids" | sed 's/^/    /')
    koa step --jobid=<id> <cmd>"
    printf '%s\n' "$ids" | grep -m1 '[0-9]'
}

cmd="${1:-}"; shift 2>/dev/null || true

case "$cmd" in
up)
    # Interactive on purpose: this is the one moment a human answers Duo.
    # ControlMaster/ControlPersist are passed explicitly rather than assumed
    # from ~/.ssh/config, so this works for someone with no Koa stanza there.
    echo "koa: opening master connection (answer any prompt)..."
    ssh -o ControlPath="$(ctl_path "$KOA_HOST")" -o ControlMaster=auto \
        -o ControlPersist="$CONTROL_PERSIST" -fN "$KOA_USER@$KOA_HOST" \
        || die "authentication failed"
    ssh -o ControlPath="$(ctl_path "$KOA_DTN")" -o ControlMaster=auto \
        -o ControlPersist="$CONTROL_PERSIST" -fN "$KOA_USER@$KOA_DTN" \
        || warn "gateway is up but the DTN is not; push will prompt"
    kctl "$KOA_HOST" check && echo "koa: socket established, ~$CONTROL_PERSIST"
    ;;

down)
    kctl "$KOA_HOST" exit; kctl "$KOA_DTN" exit
    echo "koa: sockets closed"
    ;;

status)
    if kctl "$KOA_HOST" check; then echo "socket : UP"
    else echo "socket : DOWN  (run: koa up)"; exit 1; fi
    echo "gateway: $(kssh "$KOA_HOST" hostname 2>/dev/null)"
    echo "--- your queue ---"
    kssh "$KOA_HOST" 'squeue -u $USER -o "%.10i %.9P %.20j %.2t %.10M %.6D %R"' 2>/dev/null
    ;;

q)
    # The queue with what a capacity decision needs: allocated cores (%C) and
    # memory (%m) per job. squeue's default format prints neither, so a single
    # 20-worker srun reads as "one job" and the node looks idle when it is
    # full. The user is the session's own (KOA_USER, the ssh login) unless one
    # is named, so a colleague's queue is `koa q <user>`.
    need_socket
    # the subcommand was shifted away above: an optional user name is $1
    u="${1:-$KOA_USER}"; valid_user "$u"
    kssh "$KOA_HOST" "squeue -u $u -o '%.10i %.22j %.2t %.10M %.5C %.8m %R'" 2>/dev/null
    ;;

job)
    # One job in full, the Slurm counterpart of LSF's bjobs -l: scontrol for
    # the attributes, sstat for live use (only while it runs, only your own),
    # sacct for the record (works after the job has ended). Forms:
    #   koa job <jobid>            your own session's user
    #   koa job <user> <jobid>     a colleague's job
    need_socket
    # the subcommand was shifted away above: `job <jobid>` or `job <user> <jobid>`
    if [ -n "${2-}" ]; then u="$1"; jid="$2"; else u="$KOA_USER"; jid="${1-}"; fi
    valid_user "$u"
    case "$jid" in ''|*[!0-9_]*) die "usage: koa job [user] <jobid>  (a numeric Slurm job id)";; esac
    kssh "$KOA_HOST" "scontrol show job $jid; echo '--- live (sstat; running jobs, your own only) ---'; sstat -j $jid --format=JobID,AveCPU,MaxRSS,MaxVMSize,NTasks 2>/dev/null; echo '--- record (sacct) ---'; sacct -u $u -j $jid --format=JobID,JobName%22,AllocCPUS,ReqMem,MaxRSS,Elapsed,State,ExitCode" 2>/dev/null
    ;;

queues)
    # Occupancy and scheduling expectation for the Koa partitions. sinfo
    # aggregates to one row per partition when the format omits the state
    # field; %F is nodes A/I/O/T, %C is CPUs A/I/O/T. GPU slots come from
    # GresUsed (per node, total vs allocated), and the honest "when will I
    # run" is the SCHEDULER'S own estimate (squeue --start), never a guess
    # from queue depth.
    need_socket
    PARTS="sandbox,shared,shared-long,gpu,gpu-sandbox,kill-shared"
    kssh "$KOA_HOST" '
      echo "== partition occupancy   (A/I/O/T = allocated/idle/other/total) =="
      printf "%-14s %-12s %-16s %-20s\n" PARTITION TIMELIMIT "NODES A/I/O/T" "CPUS A/I/O/T"
      sinfo -h -p '"$PARTS"' -o "%14P %12l %16F %20C"
      echo
      echo "== GPU slots, per node   (used / total) =="
      sinfo -h -N -p gpu,gpu-sandbox -O "NodeList:14,StateCompact:8,Gres:32,GresUsed:40" | sort -u
      echo
      echo "== pending pressure, by partition =="
      pd=$(squeue -h -p '"$PARTS"' -t PD -o "%P" | sort | uniq -c)
      if [ -n "$pd" ]; then echo "$pd"; else echo "  (no pending jobs in these partitions)"; fi
      echo
      echo "== your pending jobs: the scheduler own start estimates =="
      st=$(squeue -h -u $USER -t PD --start -o "%.10i %.11P %.20j %.20S %R")
      if [ -n "$st" ]; then echo "$st"; else echo "  (none pending)"; fi
      echo
      echo "reading it: idle (I) nodes in your partition + shallow pending"
      echo "  -> seconds to minutes. Deep pending with reason Priority or"
      echo "  Resources -> you wait for backfill; the start estimate above is"
      echo "  the scheduler committing itself, and N/A means it will not."
      echo "  sandbox/gpu-sandbox (4h) are the low-contention doors."
    '
    ;;

run)
    need_socket
    [ $# -gt 0 ] || die "usage: koa run <cmd...>"
    kssh "$KOA_HOST" "$*"
    ;;

step)
    need_socket
    local_jobid=""
    case "${1:-}" in --jobid=*) local_jobid="${1#--jobid=}"; shift;; esac
    [ -n "$local_jobid" ] || local_jobid="$(current_jobid)" || exit 2
    [ $# -gt 0 ] || die "usage: koa step [--jobid=N] <cmd...>"
    # --overlap: newer SLURM refuses to share allocated resources with an
    # existing step without it, which is precisely what we are doing.
    kssh "$KOA_HOST" "srun --jobid=$local_jobid --overlap bash -lc '$*'"
    ;;

batch)
    need_socket
    [ $# -gt 0 ] || die "usage: koa batch <sbatch-args...> --wrap='...'
  remember -p $KOA_PART_CPU (cpu) or -p $KOA_PART_GPU (gpu)"
    # ~/logs is created before submit so that the output lands somewhere that
    # exists -- sbatch inherits this ssh session's working directory, which is
    # your home -- and so `koa tail` knows where to look. Unless the caller
    # names an output file, the job writes ~/logs/<jobname>-<jobid>.out (and
    # stderr into it), which is exactly the pattern `koa tail` reads.
    outopt="-o logs/%x-%j.out"
    for a in "$@"; do
        case "$a" in -o|-o*|--output|--output=*) outopt="";; esac
    done
    kssh "$KOA_HOST" "mkdir -p ~/logs && sbatch $outopt $*"
    ;;

watch)
    need_socket
    id="${1:?usage: koa watch <jobid>}"
    echo "koa: polling job $id"
    while kssh "$KOA_HOST" "squeue -h -j $id -o %T" 2>/dev/null | grep -q .; do sleep 30; done
    kssh "$KOA_HOST" "sacct -j $id --format=JobID,State,Elapsed,MaxRSS,ExitCode -n" 2>/dev/null
    ;;

tail)
    need_socket
    id="${1:?usage: koa tail <jobid>}"
    kssh "$KOA_HOST" "tail -40 ~/logs/*-$id.out 2>/dev/null || ls ~/logs"
    ;;

kill)
    # Cancel the caller's OWN jobs, and only after showing them. A cancel is
    # irreversible, so this is a dry run by default and acts only under --apply.
    # Targets: job ids as Slurm spells them (123 = the whole array, 123_4 = one
    # task; comma- or space-separated) and/or --name <JobName>, narrowed by
    # --state <STATE>; --signal <SIG> sends that signal instead of ending the
    # job. Every squeue and scancel here carries -u $KOA_USER: another user's
    # job is never matched, whatever id is typed (there is deliberately no
    # [user] form, unlike `q` and `job`). Argument errors are decided before the
    # socket is needed.
    apply=0; name=""; state=""; sig=""; ids=()
    while [ $# -gt 0 ]; do
        case "$1" in
            --apply)   apply=1;;
            --name)    name="${2-}"; [ -n "$name" ] || die "kill: --name needs a job name"; shift;;
            --name=*)  name="${1#--name=}";;
            --state)   state="${2-}"; [ -n "$state" ] || die "kill: --state needs PENDING, RUNNING, ..."; shift;;
            --state=*) state="${1#--state=}";;
            --signal)  sig="${2-}"; [ -n "$sig" ] || die "kill: --signal needs a signal name or number"; shift;;
            --signal=*) sig="${1#--signal=}";;
            -h|--help) die "usage: koa kill <jobid>[,<jobid>...] [--name <JobName>] [--state <STATE>] [--signal <SIG>] [--apply]";;
            -*)        die "kill: unknown option $1";;
            *)  IFS=',' read -ra more <<< "$1"
                for t in "${more[@]}"; do
                    case "$t" in ''|*[!0-9_]*|_*|*_) die "kill: '$t' is not a Slurm job id (123 or 123_4)";; esac
                    ids+=("$t")
                done;;
        esac
        shift
    done
    [ ${#ids[@]} -gt 0 ] || [ -n "$name" ] || die "usage: koa kill <jobid>[,<jobid>...] [--name <JobName>] [--state <STATE>] [--signal <SIG>] [--apply]"
    case "$name" in *[!A-Za-z0-9_.+-]*) die "kill: --name '$name' has characters a Slurm job name does not";; esac
    case "$state" in *[!A-Za-z,_]*) die "kill: --state '$state' is not a Slurm state";; esac
    case "$sig" in *[!A-Za-z0-9]*) die "kill: --signal '$sig' is not a signal";; esac
    need_socket
    # what would go, shown first
    idlist=""; [ ${#ids[@]} -gt 0 ] && idlist=$(IFS=,; printf '%s' "${ids[*]}")
    sel="squeue -u $KOA_USER -h -o '%.12i %.22j %.2t %.10M %.5C %.8m %R'"
    [ -n "$name" ]   && sel="$sel --name=$name"
    [ -n "$state" ]  && sel="$sel -t $state"
    [ -n "$idlist" ] && sel="$sel -j $idlist"
    listing=$(kssh "$KOA_HOST" "$sel" 2>/dev/null | tr -d '\r' | grep '[0-9]')
    if [ -z "$listing" ]; then
        echo "koa: kill: no job of yours matches${idlist:+ $idlist}${name:+ --name $name}${state:+ --state $state} (already gone, or not yours)"
        exit 1
    fi
    printf '%s\n' "$listing"
    n=$(printf '%s\n' "$listing" | grep -c '[0-9]')
    if [ "$apply" -ne 1 ]; then
        echo "koa: kill: DRY RUN -- $n job line(s) above would be cancelled; add --apply to do it"
        exit 0
    fi
    sc="scancel -v -u $KOA_USER"
    [ -n "$name" ]  && sc="$sc --name=$name"
    [ -n "$state" ] && sc="$sc -t $state"
    [ -n "$sig" ]   && sc="$sc --signal=$sig"
    kssh "$KOA_HOST" "$sc ${ids[*]-}" 2>&1 | tr -d '\r' | sed 's/^/koa: /'
    sleep 2
    left=$(kssh "$KOA_HOST" "$sel" 2>/dev/null | tr -d '\r' | grep -c '[0-9]')
    if [ -n "$sig" ]; then echo "koa: kill: signal $sig sent to $n job line(s); $left still listed (expected: a signal does not end the job)"; exit 0; fi
    if [ "$left" -eq 0 ]; then echo "koa: kill: cancelled $n job line(s); none left in the queue"; exit 0; fi
    echo "koa: kill: $left of $n job line(s) still listed after scancel (completing, or scancel refused above)"; exit 1
    ;;

cost)
    # The sunk and remaining cost of jobs, COMPUTED from accounting (sacct), never by eye or by hand-arithmetic (2026-10-18:
    # a hand-estimated figure in a cancellation decision was wrong by ~4x and mislabeled its units). Units are explicit:
    # sunk CPU-hours = elapsed hours x allocated CPUs; sunk GB-hours = elapsed hours x requested GB. "Remaining" is the
    # WALLTIME BOUND of a queued or running job (time limit minus elapsed) -- an upper bound, never a prediction.
    # --resumable notes that a cancelled job's redo cost is bounded by one table write, not by its sunk time. Read-only.
    #   koa cost <jobid>[,<jobid>...] [--name <JobName>] [--since 7d|<YYYY-MM-DD>] [--resumable]
    name=""; since="7d"; resumable=0; ids=()
    while [ $# -gt 0 ]; do
        case "$1" in
            --name)      name="${2-}"; [ -n "$name" ] || die "cost: --name needs a job name"; shift;;
            --name=*)    name="${1#--name=}";;
            --since)     since="${2-}"; [ -n "$since" ] || die "cost: --since needs 7d or a date"; shift;;
            --since=*)   since="${1#--since=}";;
            --resumable) resumable=1;;
            -h|--help)   die "usage: koa cost <jobid>[,<jobid>...] [--name <JobName>] [--since 7d|<YYYY-MM-DD>] [--resumable]";;
            -*)          die "cost: unknown option $1";;
            *)  IFS=',' read -ra more <<< "$1"
                for t in "${more[@]}"; do
                    case "$t" in ''|*[!0-9_]*|_*|*_) die "cost: '$t' is not a Slurm job id (123 or 123_4)";; esac
                    ids+=("$t")
                done;;
        esac
        shift
    done
    [ ${#ids[@]} -gt 0 ] || [ -n "$name" ] || die "usage: koa cost <jobid>[,<jobid>...] [--name <JobName>] [--since 7d|<YYYY-MM-DD>] [--resumable]"
    case "$name" in *[!A-Za-z0-9_.+-]*) die "cost: --name '$name' has characters a Slurm job name does not";; esac
    case "$since" in *d) S=$(date -u -d "${since%d} days ago" +%Y-%m-%dT%H:%M);; *) S=$since;; esac
    need_socket
    sel="sacct -u $KOA_USER -S $S -X -P -n -o JobID,JobName,Partition,State,AllocCPUS,ReqMem,ElapsedRaw,TimelimitRaw"
    [ -n "$name" ] && sel="$sel --name=$name"
    [ ${#ids[@]} -gt 0 ] && sel="$sel -j $(IFS=,; printf '%s' "${ids[*]}")"
    kssh "$KOA_HOST" "$sel" 2>/dev/null | tr -d '\r' | awk -F'|' -v res="$resumable" '
    function gbof(m,  v, u) { sub(/[nc]$/, "", m); v = m + 0; u = substr(m, length(m), 1)
        if (u == "G") return v; if (u == "M") return v / 1024; if (u == "K") return v / 1048576; if (u == "T") return v * 1024; return v }
    BEGIN { printf "%-14s %-24s %-11s %-10s %4s %7s %8s  %10s %10s %11s\n", \
                   "JOBID", "NAME", "PARTITION", "STATE", "CPUS", "REQ-GB", "ELAP-h", "SUNK-CPUh", "SUNK-GBh", "REMAIN-min" }
    NF >= 8 {
        eh = $7 / 3600.0; g = gbof($6); c = $5 + 0
        sc = eh * c; sg = eh * g
        rem = "0"
